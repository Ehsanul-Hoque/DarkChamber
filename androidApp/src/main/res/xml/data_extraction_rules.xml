<?xml version="1.0" encoding="utf-8"?>
<!--
  Deny-all backup/transfer rules (API 31+). Belt-and-suspenders with allowBackup="false":
  no part of the vault (wrapped keys + ciphertext) may be exfiltrated via cloud backup or
  device-to-device transfer (docs/THREAT_MODEL.md §1). Empty allow-lists, everything excluded.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
