<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Biometric unlock. Allowlisted in config/permissions-allowlist.txt. No INTERNET. -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />

    <!-- The private camera: photos are captured into memory and encrypted straight into the vault.
         Allowlisted in config/permissions-allowlist.txt. No location permission, so no capture can
         carry a position. -->
    <uses-permission android:name="android.permission.CAMERA" />

    <!-- Any camera, front or back, and not required: a device with no camera still installs and
         the vault works there — the camera screen says it is unavailable. The back camera is named
         as well because the CAMERA permission otherwise *implies* it as required, which filters
         out every device without one (checked with `aapt2 dump badging`). -->
    <uses-feature
        android:name="android.hardware.camera.any"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />

    <!-- Not ours, and removed. CameraX pulls in its video module, which brings media3-common, whose
         library manifest asks to read network state for streaming playback. This app has no network
         code and no INTERNET permission (ADR-004), and nothing it uses from CameraX reads the network,
         so the permission would be one more line in the app's request for nothing — and it is not in
         config/permissions-allowlist.txt. -->
    <uses-permission
        android:name="android.permission.ACCESS_NETWORK_STATE"
        tools:node="remove" />

    <application
        android:name=".DarkChamberApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">
        <activity
            android:exported="true"
            android:name=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>