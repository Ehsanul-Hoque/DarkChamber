#!/usr/bin/env bash
#
# pre-commit — refuse a commit that leaves a doc comment cut off its declaration.
#
# Installed by `./gradlew installGitHooks` (sets core.hooksPath to .githooks), beside commit-msg. It
# runs the same rule CI applies — scripts/check-doc-comments.sh — on the Kotlin files this commit
# stages, as staged: a fix sitting unstaged in the working tree does not let a broken staged file in.
#
# CI stays the gate: a hook can be skipped (--no-verify), the PR check cannot.
#
set -euo pipefail

ROOT="$(git rev-parse --show-toplevel)"
STAGED="$(git diff --cached --name-only --diff-filter=ACMR -- '*.kt')"
[ -n "$STAGED" ] || exit 0

WORK="$(mktemp -d)"
trap 'rm -rf "$WORK"' EXIT

# Each staged file as it will be committed, at its own path, so the report names it as the repo does.
while IFS= read -r path; do
  mkdir -p "$WORK/$(dirname "$path")"
  git show ":$path" > "$WORK/$path"
done <<< "$STAGED"

cd "$WORK"
# shellcheck disable=SC2086 # one path per line, none with spaces (git ls-files output)
bash "$ROOT/scripts/check-doc-comments.sh" $STAGED
