# cinterop for the vendored phc-winner-argon2 reference library (cycle-2c).
#
# Only the raw hashing surface is exposed; the iosMain actual (Argon2.ios.kt) calls
# argon2id_hash_raw(...). The static library is compiled from committed C source by
# core/crypto/src/nativeInterop/argon2/build-argon2.sh via a Gradle task, and bundled
# into the klib through the cinterop's -staticLibrary / -libraryPath opts (see
# core/crypto/build.gradle.kts). includeDirs + libraryPath are supplied from Gradle so
# they stay per-target and absolute.
headers = argon2.h
package = argon2
staticLibraries = libargon2.a
