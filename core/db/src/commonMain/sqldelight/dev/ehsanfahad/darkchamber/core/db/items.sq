-- Schema v1 (docs/ARCHITECTURE.md §5).
-- Only opaque encrypted BLOBs + the sanctioned plaintext index columns. The DB never
-- interprets enc_meta / dek_wrapped; names + metadata are secrets (threat model §1–4).
CREATE TABLE items (
    id           BLOB    NOT NULL PRIMARY KEY,   -- file_id (opaque)
    album_id     BLOB,                           -- nullable; NULL = unfiled
    kind         INTEGER AS kotlin.Int NOT NULL, -- discriminator (file/note/…)
    size         INTEGER NOT NULL,               -- plaintext byte size (paging/quota)
    created_at   INTEGER NOT NULL,               -- epoch millis (sort key)
    enc_meta     BLOB    NOT NULL,               -- AES-GCM(name,mime,dims,duration,origin) — opaque
    dek_wrapped  BLOB    NOT NULL                -- per-object DEK wrapped by MK — opaque
);

CREATE INDEX items_album ON items(album_id);
CREATE INDEX items_created ON items(created_at);

upsertItem:
INSERT OR REPLACE INTO items(id, album_id, kind, size, created_at, enc_meta, dek_wrapped)
VALUES (?, ?, ?, ?, ?, ?, ?);

selectItemById:
SELECT * FROM items WHERE id = ?;

-- Newest first, both listings: these feed a gallery, and an import the user just made belongs at
-- the top of the grid rather than off the bottom of it. items_created serves either direction, so
-- this is an ORDER BY change only — no schema change, no migration.
--
-- id breaks the tie. A batch import writes many rows inside one millisecond, so equal created_at is
-- the ordinary case, and without a total order SQLite may return those rows differently each time
-- the query re-runs. The gallery re-emits on every write, keys its tiles by id and animates the
-- ones that arrive — so an unstable tie order would reshuffle the grid and play the arrival
-- animation on items that never moved.
selectItemsByAlbum:
SELECT * FROM items WHERE album_id = ? ORDER BY created_at DESC, id DESC;

selectAllItems:
SELECT * FROM items ORDER BY created_at DESC, id DESC;

-- Its own query rather than a parameter on selectItemsByAlbum: `album_id = ?` bound to NULL
-- matches nothing in SQL (NULL = NULL is NULL, not true), so the unfiled items are unreachable
-- through that parameter however it is bound. Same order and same tie-break as the other two —
-- Unfiled is a view of the gallery, not a different sort of it.
selectUnfiledItems:
SELECT * FROM items WHERE album_id IS NULL ORDER BY created_at DESC, id DESC;

-- Filing items. One statement for the whole set rather than one per item: a bulk move is then
-- atomic for free, and the catalog notifies its listeners once instead of once per item — a move of
-- fifty items would otherwise re-emit the gallery fifty times, each re-decrypting every row's
-- metadata.
--
-- The destination is nullable and NULL means "unfile these" — unambiguous here, because a
-- destination has only two kinds of answer. A *filter* needs three (see selectUnfiledItems), which
-- is why that one is not a nullable parameter.
updateItemAlbum:
UPDATE items SET album_id = ? WHERE id IN ?;

-- Emptying an album without touching its items, which is what deleting an album does: the items
-- become unfiled, and nothing is destroyed. Deleting an item's row destroys its wrapped DEK and
-- with it any way of reading the file, so an album delete must never reach the rows.
clearAlbumOnItems:
UPDATE items SET album_id = NULL WHERE album_id = ?;

deleteItemById:
DELETE FROM items WHERE id = ?;

countItems:
SELECT count(*) FROM items;

-- The per-listing counts, one per filter shape for the same NULL reason as selectUnfiledItems. They
-- read the plaintext album_id index and nothing else, so a live count costs no decrypt however large
-- the vault is — unlike counting the listing, which opens every row's enc_meta on every emission.
countUnfiledItems:
SELECT count(*) FROM items WHERE album_id IS NULL;

countItemsByAlbum:
SELECT count(*) FROM items WHERE album_id = ?;
